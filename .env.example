# PostgreSQL connection string. Supabase: Project Settings > Database > Connection string (URI).
# The app connects with SSL (ssl: 'require').
DATABASE_URL=postgresql://postgres:password@localhost:5432/reviren

# Anthropic: roadmap agent, import, pre-generation questions, session planning,
# end-of-session progress, Feynman scoring.
ANTHROPIC_API_KEY=

# Google Gemini: flashcard generation.
# Currently must also be set for any AI route to load (see src/lib/ai.ts).
GOOGLE_GENAI_API_KEY=

# Tavily web search: roadmap generation only.
TAVILY_API_KEY=
